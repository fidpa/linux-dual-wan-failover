# ============================================================================
# linux-dual-wan-failover — example configuration
# ============================================================================
#
# Copy this file to /etc/linux-dual-wan-failover/failover.conf and edit.
# Variables marked REQUIRED have no sensible defaults; the services will
# refuse to start without them.
#
# Format: shell-style KEY=VALUE. The systemd units load it via
# `EnvironmentFile=`, so quoting follows systemd-environment rules
# (single value per line, no inline comments after the value).

# ============================================================================
# Interfaces (REQUIRED)
# ============================================================================

# Primary uplink interface name as it appears in `ip link`.
# Examples: eth0 (DSL), enp1s0 (fiber NIC), wlp2s0 (wifi if you must).
PRIMARY_IFACE=eth0

# Backup uplink interface name. Typically an LTE/4G/5G modem (lte0, wwan0).
BACKUP_IFACE=lte0

# NetworkManager connection names (as shown by `nmcli connection show`).
# Used to set per-connection `ipv4.route-metric` so route changes survive
# NM reconnects.
PRIMARY_NM_CONNECTION=WAN-Primary
BACKUP_NM_CONNECTION=LTE-Backup

# Optional secondary interfaces.  Leave empty to disable.
LAN_INTERFACE=
MGMT_INTERFACE=

# ============================================================================
# Routing metrics
# ============================================================================
# When the primary is healthy, kernel chooses the lowest metric:
#   primary  metric 50  (preferred)
#   backup   metric 200 (backup)
#
# When we fail over, the primary's metric is *demoted* to 500. The backup's
# metric stays at 200 — now the lowest, so the kernel picks it. We never
# delete the primary route, so failback is just `metric 50` again.

PRIMARY_METRIC_NORMAL=50
PRIMARY_METRIC_DEMOTED=500
BACKUP_METRIC=200

# Optional explicit gateway overrides. Most setups leave these unset and let
# the failover stack auto-detect from `ip route` per-interface.
PRIMARY_GATEWAY=
BACKUP_GATEWAY=

# ============================================================================
# Health-check targets
# ============================================================================

# IPs probed via ICMP from each interface. Pick at least four reliable hosts
# with diverse anycast / network operators.
CHECK_IPS=("8.8.8.8" "1.1.1.1" "9.9.9.9" "208.67.222.222")

# Where test_wan_quality() measures latency, packet loss and jitter:
#   internet — first responding CHECK_IPS entry (the path users traverse)
#   gateway  — the next LAN hop; historical behaviour, kept as a rollback switch
#
# Measuring against the gateway makes any link look perfect: that hop is a LAN
# cable, so latency sits near 1ms and loss at 0% no matter how bad the uplink
# is. On a dual-WAN box this is worst on the *backup* link — it scores high
# while idle and only reveals itself once it is promoted to active WAN.
# The gateway is still measured and exported as wan_gateway_latency_milliseconds
# / wan_gateway_reachable, which keeps "modem dead" distinguishable from
# "uplink degraded".
WAN_QUALITY_TARGET_MODE=internet

# ICMP samples per measurement series. Latency, loss and jitter all come from
# this single series, so they describe the same moment.
WAN_QUALITY_PROBE_SAMPLES=10

# DNS servers used for the DNS test (independent of `/etc/resolv.conf`).
DNS_SERVERS=("8.8.8.8" "1.1.1.1")

# Domains to resolve in the DNS test. Should be names whose downtime is
# extremely unlikely.
DNS_TEST_DOMAINS=("google.com" "cloudflare.com")

# DNS test method:
#   doh  — DNS-over-HTTPS via curl --interface (real SO_BINDTODEVICE binding,
#          works on demoted backup interfaces). Default since v0.1.1.
#   dig  — legacy dig -b path (only sets source IP, fails on demoted backup
#          interfaces due to asymmetric routing). Kept as soft-rollback only.
# Background: dig -b sets the source IP but cannot force the outgoing
# interface, so DNS packets follow the kernel's destination-based routing.
# When the primary uplink is demoted (higher metric), packets exit via the
# active backup with the primary's source IP — return traffic gets dropped
# by the ISP or never matches the source — and the test reports a 999 ms
# timeout for a perfectly healthy primary, blocking failback.
DNS_TEST_METHOD="${DNS_TEST_METHOD:-doh}"

# ============================================================================
# Timing
# ============================================================================

CHECK_INTERVAL=15                 # seconds between scoring rounds
ROUTE_GUARDIAN_CHECK_INTERVAL=10  # seconds between route enforcement passes

# ============================================================================
# Hysteresis & anti-flap
# ============================================================================

# A score-based failover fires only when the primary stays below
# FAILOVER_THRESHOLD_DOWN for FAILURE_THRESHOLD consecutive checks.
FAILOVER_THRESHOLD_DOWN=60

# NOTE: FAILOVER_THRESHOLD_UP and HYSTERESIS_GAP are NOT evaluated by the
# daemon. Failback is governed by MIN_FAILBACK_SCORE + MIN_BACKUP_TIME +
# MIN_STABLE_DURATION (see the failback section below). The variables remain
# here, commented out, as documentation of the original hysteresis design.
# FAILOVER_THRESHOLD_UP=80   # UNUSED — failback via MIN_FAILBACK_SCORE
# HYSTERESIS_GAP=20          # UNUSED — hysteresis path was dead code, removed

FAILURE_THRESHOLD=5    # CHECK_INTERVAL × FAILURE_THRESHOLD = ~75 s tolerance
RECOVERY_THRESHOLD=20  # CHECK_INTERVAL × RECOVERY_THRESHOLD = ~5 min stability

# Emergency override — score below this triggers immediate failover, ignoring
# the consecutive-check counter. Use sparingly; lower values are safer.
EMERGENCY_THRESHOLD=15

# Cooldowns (seconds) prevent ping-pong between primary and backup.
ANTI_FLAPPING_DELAY=600           # 10 min cooldown for failback + manual actions (score-based failover has no cooldown)
EMERGENCY_FAILBACK_COOLDOWN=3600  # 60 min cooldown for emergency failback

# Emergency failback — the escape hatch for "backup is up but unusable".
# Deliberately hard to trigger: it bypasses MIN_BACKUP_TIME/MIN_STABLE_DURATION,
# so a trigger-happy setting turns it into the normal failback path. Field
# experience: with a 600 s floor and a 900 s cooldown on a flapping primary,
# every cycle ended exactly at the floor and the system kept returning to a
# link that was still broken. Raise the floor rather than the DNS threshold —
# a backup that is merely slow is still carrying traffic.
EMERGENCY_FAILBACK_DNS_THRESHOLD_MS=800  # backup DNS time above which it counts as degraded
EMERGENCY_FAILBACK_DEGRADED_CHECKS=20    # consecutive degraded checks required (see note below)
EMERGENCY_FAILBACK_MIN_PRIMARY_SCORE=60  # primary must be at least this healthy
EMERGENCY_FAILBACK_MIN_BACKUP_TIME=1800  # 30 min on backup before the escape hatch opens
#
# NOTE on DEGRADED_CHECKS: the counter ticks once per CHECK_INTERVAL, but the
# DNS value it reads is refreshed by failover-metrics-collector on its own
# (slower) cycle. Check your collector's actual cadence — if it writes every
# ~50 s and CHECK_INTERVAL is 15 s, then 20 checks (300 s) are only ~6 truly
# independent samples, and 6 checks would have been fewer than 2.

# ============================================================================
# Failback gating
# ============================================================================

MIN_FAILBACK_SCORE=60        # primary must reach this before failback is even considered
MIN_BACKUP_TIME=3600         # seconds we MUST stay on backup after failover (1 h)
MIN_STABLE_DURATION=900      # primary must stay healthy for this long (15 min)
STABILITY_RESET_THRESHOLD=50 # window resets only when score drops below this

# ============================================================================
# Last-resort failover (DANGEROUS — disabled by default)
# ============================================================================
# When the backup-link quota is exhausted (limit_pct >= 100%), `_backup_quota_cap`
# clamps the backup score to 0 — preventing failover even when the primary is dead.
# When LAST_RESORT_ENABLED=true, the orchestrator can override the cap and fail over
# anyway, on the grounds that staying online matters more than the overage charge.
#
# Trade-off:
#   false: zero surprise overage charges, but total outage if primary truly dies before quota resets
#   true:  always-online, but you may pay overage to your ISP
LAST_RESORT_ENABLED=false
LAST_RESORT_PRIMARY_THRESHOLD=25
LAST_RESORT_COOLDOWN=1800

# ============================================================================
# Latency / loss thresholds
# ============================================================================

# Wired (DSL / fiber / cable / second wired ISP).
DSL_LATENCY_EXCELLENT=15
DSL_LATENCY_GOOD=50
DSL_LATENCY_WARNING=100
DSL_LATENCY_CRITICAL=200

# Cellular (LTE / 4G / 5G). Cellular has higher physics-floor latency, so the
# thresholds are relaxed.
LTE_LATENCY_EXCELLENT=40
LTE_LATENCY_GOOD=80
LTE_LATENCY_WARNING=150
LTE_LATENCY_CRITICAL=300

# Packet-loss percentages.
PACKET_LOSS_GOOD=5
PACKET_LOSS_WARNING=10
PACKET_LOSS_CRITICAL=20

# ============================================================================
# Plugins — alerting
# ============================================================================
# Default: none.  Selectable backends ship under plugins/alerting/.
#   none       — silent (default)
#   mattermost — POST to a Mattermost incoming webhook
#   webhook    — POST to any URL
#   custom     — source $ALERTING_PLUGIN_PATH (must define `send_alert`)
ALERTING_BACKEND=none
ALERTING_PLUGIN_DIR=/usr/local/lib/linux-dual-wan-failover/plugins/alerting
ALERTING_PLUGIN_PATH=

# ============================================================================
# Plugins — backup-link quota provider (optional)
# ============================================================================
# Default: none.  Selectable providers ship under plugins/quota-providers/.
#
# A quota provider runs as its own systemd timer (its install includes the
# units), queries your modem or ISP portal, and writes a snapshot file. The
# orchestrator reads the snapshot during scoring to cap the backup-interface
# score when you approach your monthly quota — protecting you from overage
# charges during a flaky-but-not-dead primary.
#
# Built-in providers:
#   none           — disabled (default)
#   netgear-lm1200 — reference implementation (Sierra Wireless D86 firmware)
#   custom         — write your own from plugins/quota-providers/custom-template/
QUOTA_PROVIDER=none

# Path to the snapshot file produced by the selected provider.
QUOTA_SNAPSHOT_PATH=/var/lib/linux-dual-wan-failover/quota-snapshot.json

# Maximum age of the snapshot before the cap is ignored (graceful degradation
# when the provider is stuck).
QUOTA_SNAPSHOT_MAX_STALE_SEC=3600

# Score caps per quota tier. The cap takes effect on the BACKUP_IFACE only.
QUOTA_CAP_TIER_90=40    # ≥90 % of monthly quota → cap to 40
QUOTA_CAP_TIER_96=10    # ≥96 % → cap to 10
QUOTA_CAP_TIER_100=0    # ≥100 % → cap to 0 (effectively blocks failover)

# ============================================================================
# Hardware sensors (optional)
# ============================================================================
# Backend for temperature / throttle monitoring. The failover logic does
# NOT depend on this — it's purely informational.
#   none           — disabled (default)
#   thermal_zone0  — read /sys/class/thermal/thermal_zone0/temp (cross-platform)
#   vcgencmd       — Raspberry Pi specific (`vcgencmd measure_temp`)
HARDWARE_TEMP_BACKEND=none

# ============================================================================
# Logging / state directories (override only if you know why)
# ============================================================================
# Default-guard form (${VAR:-default}): an environment override — e.g. a
# test harness pointing STATE_DIR at a tmpdir — must not be clobbered by
# sourcing this file.

LOG_DIR="${LOG_DIR:-/var/log/linux-dual-wan-failover}"
STATE_DIR="${STATE_DIR:-/var/lib/linux-dual-wan-failover}"
RUNTIME_DIR="${RUNTIME_DIR:-/run/linux-dual-wan-failover}"

# ============================================================================
# Optional Web-UI (failover-web.service)
# ============================================================================
# When the Web-UI is installed (`./install.sh --with-web-ui`), it reads the
# same failover.conf as the daemon and adds a few overrides of its own. The
# defaults below are baked into systemd/failover-web.service — change them
# here only if you customised the directory layout.
#
# Set FAILOVER_WEB_CSRF_HOSTS to the hostname your reverse proxy serves the
# UI on, separated by commas. The default ("localhost,127.0.0.1") only works
# for local curl smoke tests.

# FAILOVER_WEB_CSRF_HOSTS=failover.local,localhost
# FAILOVER_WEB_LABEL_PRIMARY=DSL
# FAILOVER_WEB_LABEL_BACKUP=LTE
# FAILOVER_WEB_PROM_URL=http://prometheus.local:9090

# ============================================================================
# Toolkit lookup (optional, advanced)
# ============================================================================
# bash-production-toolkit provides structured logging and atomic-write helpers.
# linux-dual-wan-failover auto-detects the toolkit at:
#   - $TOOLKIT_LIB        (env override)
#   - /usr/local/lib/bash-production-toolkit/foundation
#   - <repo>/vendor/bash-production-toolkit/src/foundation (if vendored)
# Set this only if your toolkit lives somewhere else.
TOOLKIT_LIB=
