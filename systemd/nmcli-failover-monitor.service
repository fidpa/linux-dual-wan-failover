[Unit]
Description=linux-dual-wan-failover — event-driven detection (nmcli)
Documentation=https://github.com/fidpa/linux-dual-wan-failover
After=network-online.target NetworkManager.service failover-monitor.service
Wants=network-online.target NetworkManager.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root

EnvironmentFile=-/etc/linux-dual-wan-failover/failover.conf

ExecStart=/usr/local/lib/linux-dual-wan-failover/services/nmcli-failover-monitor.sh

RuntimeDirectory=linux-dual-wan-failover
RuntimeDirectoryMode=0755
StateDirectory=linux-dual-wan-failover/nmcli-monitor
StateDirectoryMode=0750
LogsDirectory=linux-dual-wan-failover
LogsDirectoryMode=0755

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nmcli-failover-monitor

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
NoNewPrivileges=yes
PrivateTmp=yes

# Needs to send SIGUSR1 to failover-monitor; otherwise read-only ops on `ip` and `nmcli`.
CapabilityBoundingSet=CAP_KILL CAP_NET_ADMIN
AmbientCapabilities=CAP_KILL CAP_NET_ADMIN

# Event listener (NetworkManager state changes). Mostly idle, but must wake
# up and send SIGUSR1 within milliseconds when an event fires. CPUQuota=20%
# was tight enough to add latency in tests. 50 % is comfortable for the
# event-handling bursts; remove the quota entirely on a dedicated box.
MemoryMax=50M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
