[Unit]
Description=linux-dual-wan-failover — orchestrator
Documentation=https://github.com/fidpa/linux-dual-wan-failover
After=network-online.target NetworkManager.service
Wants=network-online.target
After=route-guardian.service
Wants=route-guardian.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root

EnvironmentFile=-/etc/linux-dual-wan-failover/failover.conf

ExecStart=/usr/local/lib/linux-dual-wan-failover/services/failover-monitor.sh

RuntimeDirectory=linux-dual-wan-failover
RuntimeDirectoryMode=0755
StateDirectory=linux-dual-wan-failover
StateDirectoryMode=0750
LogsDirectory=linux-dual-wan-failover
LogsDirectoryMode=0755

PIDFile=/run/linux-dual-wan-failover/failover-monitor.pid

# Restart=always (not on-failure) so script-watch.sh's exit 0 on code change
# triggers a clean restart. `systemctl stop` deactivates the unit and breaks
# the loop, so there is no infinite-restart risk in practice.
Restart=always
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=failover-monitor

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
NoNewPrivileges=yes
PrivateTmp=yes

# Capabilities: only what we need for `ip route` manipulation.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Resource limits.
# The orchestrator runs many short-lived bash subshells in parallel during a
# scoring round. We measured ~44 % throttling at CPUQuota=50% on a Pi 5,
# which delayed score updates and therefore failover/failback decisions.
# 75 % gives generous headroom for bursty parallel tests. On a dedicated
# router box, remove CPUQuota entirely.
MemoryMax=100M
MemoryHigh=80M
CPUQuota=75%

[Install]
WantedBy=multi-user.target
