# Netgear LM1200 collector secrets.
# Copy to /etc/linux-dual-wan-failover/lm1200.env (mode 0600, owned by root).

# Modem admin password (the one you use on http://<modem-ip>/).
LM1200_PASSWORD=replace-me

# Optional: override the modem IP. Default is the factory 192.168.0.1.
# LM1200_MODEM_IP=192.168.0.1
